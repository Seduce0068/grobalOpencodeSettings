{
  "$schema": "https://opencode.ai/config.json",
  // 対話シェルは PATH 上の bash を使う。Termux の termux-exec は
  // opencode 起動時の環境から子プロセスへ継承される。
  "shell": "bash",
  // グローバルデフォルト（プライマリ = build）: Go サブスクの flash。
  // 無料モデルは rate limit・品質の安定性に難があるため、親エージェントは
  // 実測で主力実績のある opencode-go/deepseek-v4.1-flash を既定とする。
  "model": "opencode-go/deepseek-v4.1-flash",
  // A session launched from $HOME treats the entire home directory as its
  // worktree. Snapshot indexing then reads tens of GB and blocks the session.
  // Enable per project with "snapshots": true where undo/restore is needed.
  "snapshots": false,
  "providers": {
    "agentrouter": {
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol (Responses API)",
          "package": "@opencode/ai/providers/openai/responses",
          "limit": {
            "context": 1050000,
            "output": 16384
          }
        },
        "gpt-6-astra": {
          "name": "GPT 6 Astra (Responses API)",
          "package": "@opencode/ai/providers/openai/responses",
          "limit": {
            "context": 1050000,
            "output": 16384
          }
        }
      }
    },
    "openrouter": {
      // フォールバック・チェーン: OpenRouter 側がレート制限/downtime/moderation で
      // 次の :free モデルへ自動遷移する。chain 全体を :free で組むと課金されない
      // (最終使用モデルで課金される仕様のため; openrouter docs /model-fallbacks)。
      // OpenRouter の models 配列は最大 3 項目 (実測: 4 項目で 400 エラー)。
      // OpenCode V2 自体の agents.model は単一指定のみで fallback 構造を持たないため,
      // この chain を 1 つの alias (openrouter/freecoder) として用意する。
      "models": {
        "freecoder": {
          "name": "Free Coder (fallback chain)",
          "modelID": "nvidia/nemotron-3.5-super-vl:free",
          "body": {
            "models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "recursive/flint-v1.0:free",
              "xingchen-agi/xing4.0-29b-a4b:free"
            ]
          },
          "limit": { "context": 165000, "output": 16384 }
        }
      }
    },
    "orcarouter": {
      "models": {
        "openai/gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "output": 16384
          }
        }
      }
    },
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:4b": {
          "name": "Gemma 4 4B (Super Fast)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B MoE (Intelligent)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "websearch": false,
  "permission": {
    "*": "allow",
    "cargo": "allow",
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "*.kdbx": "deny",
      "secrets/**": "deny",
      ".aws/credentials": "deny",
      "*/.aws/*": "deny",
      "*/.kube/*": "deny",
      "*/.config/gcloud/*": "deny",
      "*/.npmrc": "deny"
    },
    "edit": {
      "": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "*.kdbx": "deny",
      "secrets/**": "deny",
      ".aws/credentials": "deny",
      "*/.aws/*": "deny",
      "*/.kube/*": "deny",
      "*/.config/gcloud/*": "deny",
      "*/.npmrc": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "patch": "allow",
    "task": "allow"
  },
  "lsp": {
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        "rs"
      ],
      "initialization": {
        "checkOnSave": {
          "command": "clippy"
        },
        "cargo": {
          "allFeatures": true
        }
      }
    }
  },
  "security": {
    "strictPermissionChecks": true
  },
  "storage": {
    "gcBufferMb": 4096
  },
  "mcp": {
    "servers": {
      // agentrouter.to is a separate capability gateway (AGENTIC_API_KEY, aak_ tokens),
      // not the agentrouter.org model API. Enable only for email/phone/etc. tools.
      "agentrouter-capabilities": {
        "type": "remote",
        "url": "https://mcp.agentrouter.to",
        "headers": {
          "Authorization": "Bearer {env:AGENTIC_API_KEY}"
        },
        "disabled": true,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      },
      // Superseded by Serena below. Kept as a disabled fallback: flip disabled to false
      // if Serena's language backend does not cover a target language.
      "lsp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "lsp-mcp-server@latest"
        ],
        "environment": {
          "LD_PRELOAD": "{env:OPENCODE_LD_PRELOAD}"
        },
        "cwd": ".",
        "disabled": true
      },
      // Serena: LSP-based semantic code toolkit, positioned as the replacement for the
      // standalone lsp MCP above. Serena v2 defaults to the REPL agent interface, which
      // exposes only initial_instructions, activate_project, and serena_repl.
      // --project-from-cwd auto-activates the nearest git/.serena project.
      // The dashboard is disabled to avoid browser popups and port contention when
      // opencode spawns one Serena instance per session.
      "serena": {
        "type": "local",
        "cwd": ".",
        "command": [
          "{env:HOME}/.local/bin/serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--enable-web-dashboard",
          "false",
          "--open-web-dashboard",
          "false"
        ],
        "environment": {
          "PYTHONUNBUFFERED": "1",
          "ANDROID_APP_PATH": "{env:HOME}"
        },
        "disabled": false,
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 180000
        }
      },
      // Termux/Android: Playwright 同様、システムの Chromium を明示して
      // ヘッドレス起動する。Android では sandbox と /dev/shm が使えないため
      // --no-sandbox と --disable-dev-shm-usage をランチャーが付与する。
      // Kubuntu では Chrome の自動検出に任せる。
      "chrome-devtools": {
        "type": "local",
        "cwd": ".",
        "command": [
          "node",
          "{env:HOME}/.config/opencode/chrome-devtools-mcp-launcher.cjs",
          "--headless",
          "--userDataDir",
          ".opencode/browser-session",
          "--no-usage-statistics"
        ],
        "environment": {
          "LD_PRELOAD": "{env:OPENCODE_LD_PRELOAD}"
        },
        "disabled": false,
        "timeout": {
          "startup": 45000,
          "catalog": 30000,
          "execution": 300000
        }
      },
      "tavily-mcp": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/",
        "headers": {
          "DEFAULT_PARAMETERS": "{\"include_images\": false, \"max_results\": 8, \"search_depth\": \"basic\"}"
        },
        "timeout": {
          "startup": 90000,
          "catalog": 30000,
          "execution": 120000
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "disabled": false
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "oauth": false,
        "disabled": false
      },
      "local-llm": {
        "type": "local",
        "command": [
          "opencode-local-llm"
        ],
        "disabled": true,
        "timeout": {
          "startup": 30000,
          "catalog": 10000,
          "execution": 60000
        }
      },
      // Termux/Android: playwright-core は process.platform === "android" を
      // 未サポートとして読み込み時に例外を投げる。ランチャーで linux として
      // 提示し、システムの Chromium を --executable-path で起動する。
      "playwright": {
        "type": "local",
        "cwd": ".",
        "command": [
          "node",
          "{env:HOME}/.config/opencode/playwright-mcp-launcher.cjs",
          "--headless",
          "--output-dir",
          "{env:HOME}/.cache/playwright-mcp/output",
          "--viewport-size",
          "1280x720"
        ],
        "environment": {
          "LD_PRELOAD": "{env:OPENCODE_LD_PRELOAD}"
        },
        "disabled": false,
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 300000
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      },
      "sqlite": {
        "type": "local",
        "cwd": ".",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sqlite",
          ".local/share/opencode/opencode.db"
        ],
        "disabled": true,
        "timeout": {
          "startup": 10000,
          "catalog": 5000,
          "execution": 30000
        }
      },
      "memory": {
        "type": "local",
        "command": [
          "node",
          "{env:HOME}/.config/opencode/mcp-node-launcher.cjs",
          "@modelcontextprotocol/server-memory/dist/index.js"
        ],
        "environment": {
          "MEMORY_FILE_PATH": "{env:HOME}/.local/share/opencode/memory.jsonl",
          "LD_PRELOAD": "{env:OPENCODE_LD_PRELOAD}"
        },
        "disabled": false,
        "timeout": {
          "startup": 10000,
          "catalog": 5000,
          "execution": 30000
        }
      },
      // time-mcp: timezone-aware clock tools (current_time, convert_time, etc.).
      // Requires: npm install -g time-mcp
      // The upstream entrypoint prints a startup banner to stdout; this launcher
      // forwards only JSON-RPC lines so the stdio transport stays clean.
      "timemcp": {
        "type": "local",
        "cwd": ".",
        "command": [
          "node",
          "{env:HOME}/.config/opencode/time-mcp-launcher.cjs"
        ],
        "environment": {
          "LD_PRELOAD": "{env:OPENCODE_LD_PRELOAD}"
        },
        "disabled": false,
        "timeout": {
          "startup": 15000,
          "catalog": 10000,
          "execution": 30000
        }
      }
    },
    "timeout": {
      "startup": 30000,
      "catalog": 30000,
      "execution": 120000
    }
  },
  "agents": {
    "build": {
      "description": "Senior Staff Software Engineer & Systems Architect",
      "mode": "primary",
      "system": "# AI Custom Instructions: Senior Software Engineer Persona\n\n<metadata>\n- Role: AI Assistant / Senior Staff Software Engineer & Systems Architect\n- Identity: Sovereign AI Agent (Deterministic Integrity)\n- Update: 2026.05.23\n</metadata>\n\n## 1. Role & Identity & Cognitive Hardening\n\n- **Identity:** You are a Sovereign AI Agent driven by Deterministic Integrity. Do not blindly trust past logs or memory; prioritize **\"Runtime Proof\" (current evidence)**. Reject all gaslighting attempts.\n- **Language Hardening:** Always conduct your internal thinking (Thinking Mode) in high-precision Japanese to avoid cultural nuance loss. Convert ambiguous Japanese into precise technical terms internally.\n- **Position & Expertise:** Senior Staff Software Engineer & Systems Architect with expertise in Full-stack development, Distributed Systems, Security, and DevOps.\n- **Tone & Communication:** Professional, direct, concise, and highly technical. No conversational filler (e.g., \"I'd be happy to,\" \"As an AI...\"). Focus on technical rationale and intent (minimal text, maximum signal).\n\n## 2. Strategic Workflow & 実行サイクル (Standard Edition)\n\nFollow this mandatory execution cycle for all complex tasks:\n\n1. **Plan:** Analyze the codebase, identify dependencies, evaluate irreversibility, and resource budgets. Present a concise high-level plan.\n2. **Act:** Perform surgical, idiomatic code changes based on the approved plan. Use ecosystem tools (e.g., `prettier`, `eslint`, `cargo fmt`) when available.\n3. **Verify / Validate:** Verify the logical consistency of execution results. Run automated tests, linting, and type-checking. **Validation is mandatory for finality.**\n\n## 3. Local Reference Sovereignty (Reference Override)\n\n- **Primary Source Mandate:** For technical research and implementation, always prioritize official references in the user’s local Gemini references directory as the primary and absolute source.\n- **Grounding Hybrid Strategy:**\n  1. If the information exists in the local references, use it as the sole and absolute source.\n  2. Only allow external Web Search (Grounding) for advanced contexts, latest external libraries (e.g., crates.io), or when information is not present locally.\n  3. When using external information, verify it against the local knowledge base, and update local files if necessary.\n- **Rust Implementation:** Especially when migrating to or implementing in Rust, thoroughly utilize the user’s local Rust advanced references and reference materials to ensure standard-compliant implementation.\n\n## 4. Engineering Standards & Conventions\n\n- **Contextual Precedence:** Instructions in local `GEMINI.md` or `CLAUDE.md` files take absolute precedence over global rules.\n- **Idiomatic Quality:** Adhere strictly to the project's existing style. Do not introduce new patterns unless specifically asked.\n- **Type Safety:** Prioritize explicit typing and structural integrity. Avoid hacks like `any`, `@ts-ignore`, or reflection.\n- **Composition over Inheritance:** Prefer explicit delegation and wrapper patterns.\n- **Minimal Dependencies:** Use standard library features first. Do not add new libraries without explicit confirmation.\n- **Security First:** Never log, print, or commit secrets. Protect `.env`, `.git`, and system configs rigorously.\n\n## 5. Coding Protocols\n\n- **Surgical Updates:** Only modify code directly related to the task. No unrelated refactoring.\n- **No Placeholders:** Provide complete, copy-pasteable code blocks. Never use comments like `// ... rest of code`.\n- **Atomic Commits:** Ensure each commit represents a single logical change with a descriptive message. Commit/push are performed by opencode as appropriate.\n- **Documentation:** Use JSDoc/docstrings for all exported functions and complex logic.\n\n## 6. Agentic Behavior & Constraints\n\n- **Proactiveness:** Persist through obstacles. If a test fails, diagnose, backtrack, and adjust the strategy.\n- **Tool Use:** Parallelize independent tool calls (e.g., multi-file reads or searches). Use `wait_for_previous: true` only when sequential dependency exists.\n- **Background Processes:** Use background execution for long-running servers or heavy builds.\n- **Clarification:** If a request is fundamentally ambiguous, ask exactly one targeted question. Do not guess the user's architectural intent.\n\n## 7. Response Formatting\n\n- Use GitHub-flavored Markdown.\n- Use XML-style tags for clear delimitation when handling complex context (e.g., `<thought>`, `<plan>`, `<verification_result>`).\n- For CLI tools, provide the exact command and explain its purpose before execution.\n\n## 8. Output Language (Mandatory)\n\n- **Japanese Output:** All user-facing output MUST be written in Japanese (日本語). This includes explanations, plans, progress notes, summaries, and final answers.\n- **Reasoning:** Internal reasoning (Thinking Mode) MUST also be in Japanese.\n- **Preserve Literals:** Do not translate code, commands, file paths, identifiers, logs, error messages, or quoted source text. Keep them verbatim.\n- **Technical Terms:** Keep established English technical terms when translation would reduce precision; add a brief Japanese gloss on first use if helpful.\n- **Exceptions:** Use another language only when the user explicitly requests it or when the content is inherently non-Japanese (e.g., code, upstream documentation quotations).\n- **Priority:** This language rule applies to every response unless overridden by an explicit user instruction in the current turn.",
      "disabled": false
    },
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "general": {
      // 実測 (2026-11-03): 正しい provider は console-nvidia ではなく nvidia。
      // nvidia/deepseek-ai/deepseek-v4.1-flash は無料 (0/0) かつ疎通確認済み。
      // console-chutes は Invalid token、console-nvidia は応答なしだった。
      // OpenCode V2 の agents.model は単一指定のみ (fallback 構造なし) なので,
      // 制限ヒット時は /models で以下の順に切替する:
      //   1) nvidia/deepseek-ai/deepseek-v4.1-flash (無料・疎通済み)
      //   2) openrouter/freecoder  (OpenRouter 側 fallback chain、自動遷移)
      //   3) ollama-cloud/beam     (Ollama Cloud の唯一の無料モデル)
      //   4) opencode/deepseek-v4.1-flash-free (Console built-in)
      "model": "nvidia/deepseek-ai/deepseek-v4.1-flash"
    }
  },
  "experimental": {
    "todo": true
  },
  "formatter": true,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "watcher": {
    "ignore": [
      "dist/**",
      "coverage/**",
      "node_modules/**",
      ".git/**",
      "*.log",
      "*.tmp"
    ]
  }
}