{
  "//": "opencode 設定リポジトリの Markdown lint 規約。CI と agent の pre-commit 検査で共有する。",
  "ignores": ["node_modules/**", "browser-session/**", ".git/**"],
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD041": {
      "front_matter_title": "^\\s*(title|name|description)\\s*[:=]"
    },
    "MD060": {
      "style": "consistent"
    }
  }
}
